# Panel de administracion
ADMIN_SESSION_SECRET=una-cadena-larga-y-aleatoria

# Usuarios del panel. Genera cada entrada con scripts/hash-password.mjs.
# Formato: [{"username":"nelson","name":"Nelson","role":"admin","salt":"...","hash":"..."}]
ADMIN_USERS=

# Clave unica heredada (opcional, solo si no usas ADMIN_USERS)
# ADMIN_PASSWORD=

# Almacenamiento del panel (Vercel Blob, se crea desde el Marketplace)
BLOB_READ_WRITE_TOKEN=

# Meta Ads (Marketing API). El pixel publico va en la configuracion del panel.
META_ACCESS_TOKEN=

# Dominio publico para el QR. Si falta, se toma del host de la peticion.
NEXT_PUBLIC_SITE_URL=

# Wompi (widget de checkout). Sin llaves, el flujo se simula fuera de produccion.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Postgres del sistema de donaciones (Supabase, pooler en modo transaccion).
# Sin DATABASE_URL las donaciones viven en memoria y el recaudo en linea no persiste.
DATABASE_URL=

# YouTube Data API para detectar el directo actual (opcional).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCrdNxBU4cfR0rEHY1OO9tQQ

# Resend para los recordatorios del live (opcional hasta que exista la clave).
RESEND_API_KEY=
RESEND_FROM="La Supercasa <recordatorios@svgvisual.com>"
