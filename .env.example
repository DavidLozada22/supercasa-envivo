# Panel de administracion
ADMIN_SESSION_SECRET=una-cadena-larga-y-aleatoria

# Usuarios del panel. Genera cada entrada con scripts/hash-password.mjs.
# Formato: [{"username":"nelson","name":"Nelson","role":"admin","salt":"...","hash":"..."}]
ADMIN_USERS=

# Clave unica heredada (opcional, solo si no usas ADMIN_USERS)
# ADMIN_PASSWORD=

# Almacenamiento del panel (Vercel Blob, se crea desde el Marketplace)
BLOB_READ_WRITE_TOKEN=

# Meta Ads (Marketing API). El pixel publico va en la configuracion del panel.
META_ACCESS_TOKEN=

# Dominio publico para el QR. Si falta, se toma del host de la peticion.
NEXT_PUBLIC_SITE_URL=
